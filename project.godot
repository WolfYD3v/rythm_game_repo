config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Outside of Hoyploma"
config/description="A Rythm Game That Plays On Multiple Windows."
run/main_scene="uid://du02s2cxy4jtc"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="uid://jd5lbwo58yvt"
config/windows_native_icon="res://exports/game_icon.ico"

[audio]

buses/default_bus_layout="uid://cu3bjoj26htb5"

[autoload]

